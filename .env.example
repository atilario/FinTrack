# ========================================================
# FINTRACK — VARIÁVEIS DE AMBIENTE (ENV CONFIGURATION)
# ========================================================

# 1. Banco de Dados Turso (libSQL/SQLite em Nuvem)
# Obtenha com: turso db show fintrack --url e turso db tokens create fintrack
TURSO_DATABASE_URL=libsql://fintrack-seu-usuario.turso.io
TURSO_AUTH_TOKEN=seu_token_de_autenticacao_turso_aqui

# 2. Autenticação e Segurança (Sessões JWT & Criptografia)
# Gere uma string segura com: openssl rand -base64 32
AUTH_SECRET=sua_chave_secreta_jwt_de_pelo_menos_32_caracteres_aleatorios

# 3. Ambiente e Porta (Render define PORT automaticamente)
NODE_ENV=production
PORT=3000
